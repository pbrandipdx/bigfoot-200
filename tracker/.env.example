# Copy to tracker/.env and fill in. tracker/.env is gitignored - never commit it.
# Put ONLY the value after the '=' - no trailing comments, they become part of the value.

GARMIN_EMAIL=
GARMIN_PASSWORD=
SUPABASE_URL=https://mwjprmuwdhfjlldrruhx.supabase.co
SUPABASE_SERVICE_KEY=

# GARMIN_PASSWORD is needed only for the first run; a token caches to
#   ~/.garminconnect and you can blank it afterwards.
# SUPABASE_SERVICE_KEY: Supabase dashboard, bigfoot-200-training,
#   Project Settings, API, the service_role key (not anon - RLS is on).
